# EXAMPLE ONLY: copy this template to .env and set local/deployment values there.
# Never add passwords, access tokens, refresh tokens or API secrets to this file.
# Every VITE_* value is public and may be embedded in browser JavaScript.

# Public browser API path. /api uses the development proxy below.
VITE_API_BASE_URL=/api

# Server-only development proxy. Do not prefix this variable with VITE_.
# The dev proxy overwrites X-Guardian-Portal with staff/public from the running mode.
API_PROXY_TARGET=http://localhost:8080

# Local frontend ports (server-only). Restart both dev servers after changing.
PUBLIC_FRONTEND_PORT=5137
STAFF_FRONTEND_PORT=5138

# Public origins used for navigation between the two frontend portals.
# Keep these origins consistent with the ports above; use your HTTPS domains in production.
VITE_PUBLIC_PORTAL_URL=http://localhost:5137
VITE_STAFF_PORTAL_URL=http://localhost:5138
