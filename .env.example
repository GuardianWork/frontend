# API prefix; keep /api to use the Vite development proxy.
VITE_API_BASE_URL=/api

# Optional Vite proxy target (shell environment). Default: http://localhost:8080
# VITE_API_PROXY_TARGET=http://localhost:8080

# Alternatively, use a full backend URL when that backend enables browser CORS:
# VITE_API_BASE_URL=http://localhost:8080/api
