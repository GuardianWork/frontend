      "css": ".ds-nav{display:flex;flex-wrap:wrap;gap:26px;background:var(--color-paper);border-bottom:1px solid var(--color-rule);font-family:var(--font-body)}.ds-nav a{padding:20px 0;border-bottom:2px solid transparent;color:var(--color-ink);font-size:14px;font-weight:600;text-decoration:none}.ds-nav a:hover,.ds-nav a[aria-current]{color:var(--color-accent);border-color:var(--color-accent)}.ds-nav a:focus-visible{outline:3px solid var(--color-focus);outline-offset:3px}"
    }
