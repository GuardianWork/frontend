      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main public recruitment action.",
      "html": "<button class=\"ds-button\">Tìm việc</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:13px 24px;min-height:48px;border:1px solid transparent;border-radius:8px;background:var(--color-accent);color:var(--color-accent-ink);font-family:var(--font-body);font-size:15px;font-weight:700;cursor:pointer;transition:background-color 160ms ease}.ds-button:hover{background:var(--color-accent-hover)}.ds-button:focus-visible{outline:3px solid var(--color-focus);outline-offset:3px}.ds-button:disabled{opacity:.55;cursor:not-allowed}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Supporting action beside a primary action.",
      "html": "<button class=\"ds-outline\">Xem công việc</button>",
      "css": ".ds-outline{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:13px 24px;min-height:48px;border:1px solid transparent;border-radius:8px;background:var(--color-accent);color:var(--color-accent-ink);font-family:var(--font-body);font-size:15px;font-weight:700;cursor:pointer;transition:background-color 160ms ease}.ds-outline:hover{background:var(--color-accent-hover)}.ds-outline:focus-visible{outline:3px solid var(--color-focus);outline-offset:3px}.ds-outline:disabled{opacity:.55;cursor:not-allowed}.ds-outline{background:var(--color-paper);color:var(--color-accent);border-color:var(--color-accent)}.ds-outline:hover{background:var(--color-accent-subtle)}"
    },
    {
      "name": "Search Input",
      "kind": "input",
      "refersTo": "search-input",
      "description": "Keyword input inside the public search form.",
      "html": "<label class=\"ds-field\"><span>Từ khóa</span><input placeholder=\"Chức danh, kỹ năng hoặc công ty\" /></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:8px;padding:10px 16px;background:var(--color-paper);color:var(--color-ink);font-family:var(--font-body);font-size:15px}.ds-field input{min-height:44px;border:0;background:transparent;color:var(--color-ink);font:inherit;caret-color:var(--color-accent)}.ds-field input::placeholder{color:var(--color-ink-3)}.ds-field input:focus-visible{outline:3px solid var(--color-focus);outline-offset:3px}"
    },
