  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main public recruitment action. Base rounded variant from DESIGN.md; modern public surfaces override corners to square.",
      "html": "<button class=\"ds-button\">Tìm việc</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:13px 24px;min-height:48px;border:1px solid transparent;border-radius:8px;background:var(--color-accent);color:var(--color-accent-ink);font-family:var(--font-body);font-size:15px;font-weight:700;cursor:pointer;transition:background-color 160ms ease}.ds-button:hover{background:var(--color-accent-hover)}.ds-button:focus-visible{outline:3px solid var(--color-focus);outline-offset:3px}.ds-button:disabled{opacity:.55;cursor:not-allowed}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Supporting action beside a primary action. Base rounded variant from DESIGN.md; modern public surfaces override corners to square.",
      "html": "<button class=\"ds-outline\">Xem công việc</button>",
      "css": ".ds-outline{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:13px 24px;min-height:48px;border:1px solid transparent;border-radius:8px;background:var(--color-accent);color:var(--color-accent-ink);font-family:var(--font-body);font-size:15px;font-weight:700;cursor:pointer;transition:background-color 160ms ease}.ds-outline:hover{background:var(--color-accent-hover)}.ds-outline:focus-visible{outline:3px solid var(--color-focus);outline-offset:3px}.ds-outline:disabled{opacity:.55;cursor:not-allowed}.ds-outline{background:var(--color-paper);color:var(--color-accent);border-color:var(--color-accent)}.ds-outline:hover{background:var(--color-accent-subtle)}"
    },
    {
      "name": "Search Input",
      "kind": "input",
      "refersTo": "search-input",
      "description": "Keyword input inside the public search form.",
      "html": "<label class=\"ds-field\"><span>Từ khóa</span><input placeholder=\"Chức danh, kỹ năng hoặc công ty\" /></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:8px;padding:10px 16px;background:var(--color-paper);color:var(--color-ink);font-family:var(--font-body);font-size:15px}.ds-field input{min-height:44px;border:0;background:transparent;color:var(--color-ink);font:inherit;caret-color:var(--color-accent)}.ds-field input::placeholder{color:var(--color-ink-3)}.ds-field input:focus-visible{outline:3px solid var(--color-focus);outline-offset:3px}"
    },
    {
      "name": "Popular Skill Chip",
      "kind": "chip",
      "refersTo": "popular-chip",
      "description": "A linked popular keyword beneath search.",
      "html": "<a class=\"ds-chip\" href=\"#jobs\">Kinh doanh</a>",
      "css": ".ds-chip{display:inline-block;padding:4px 12px;border-radius:5px;background:var(--color-paper);color:var(--color-ink-2);font-family:var(--font-body);font-size:13px;text-decoration:none}.ds-chip:hover{color:var(--color-accent);text-decoration:underline}.ds-chip:focus-visible{outline:3px solid var(--color-focus);outline-offset:3px}"
    },
    {
      "name": "Job Card",
      "kind": "card",
      "refersTo": "job-card",
      "description": "Documented base listing primitive; modern.css presents public collections as unboxed rows.",
      "html": "<a class=\"ds-card\" href=\"#job\"><span class=\"ds-company\">GuardianWork</span><h3>Chuyên viên kinh doanh</h3><span class=\"ds-salary\">Thỏa thuận</span><span class=\"ds-location\">TP. Hồ Chí Minh</span></a>",
      "css": ".ds-card{display:flex;flex-direction:column;gap:10px;padding:22px;border:1px solid var(--color-rule);border-radius:12px;background:var(--color-paper);color:var(--color-ink);font-family:var(--font-body);text-decoration:none;transition:border-color 160ms ease,background-color 160ms ease}.ds-card:hover{border-color:var(--color-accent);background:var(--color-paper-2)}.ds-card:focus-visible{outline:3px solid var(--color-focus);outline-offset:3px}.ds-company,.ds-location{color:var(--color-ink-2);font-size:13px}.ds-card h3{font-size:18px;font-weight:700;line-height:1.45;margin:8px 0 0}.ds-salary{font-size:14px;font-weight:650;color:var(--color-accent)}"
    },
    {
      "name": "Public Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Current and supporting public destinations.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Điều hướng\"><a href=\"#jobs\" aria-current=\"page\">Tìm việc làm</a><a href=\"#employers\">Nhà tuyển dụng</a></nav>",
      "css": ".ds-nav{display:flex;flex-wrap:wrap;gap:2px;background:var(--color-paper);font-family:var(--font-body)}.ds-nav a{display:inline-flex;align-items:center;min-height:40px;padding:0 13px;border-radius:8px;color:var(--color-ink-2);font-size:14px;font-weight:600;text-decoration:none;transition:background-color 160ms ease-out,color 160ms ease-out}.ds-nav a:hover{background:var(--color-paper-2);color:var(--color-ink)}.ds-nav a[aria-current=\"page\"]{background:var(--color-accent-subtle);color:var(--color-accent-deep)}.ds-nav a:focus-visible{outline:3px solid var(--color-focus);outline-offset:3px}"
    },
    {
      "name": "Candidate and Recruiter Workspace Sidebar",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Compact, collapsible role navigation inside the persistent Candidate/recruiter frame; Staff navigation remains separate. The 44×44 collapse control sits in the persistent header.",
      "html": "<aside class=\"ds-workspace\" aria-label=\"Điều hướng ứng viên\"><div class=\"ds-workspace-brand\">GuardianWork</div><nav aria-label=\"Điều hướng chính\"><a class=\"ds-workspace-link\" href=\"#jobs\" aria-label=\"Tìm việc làm\" aria-current=\"page\"><svg viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"M3 4h14v12H3zM7 4v12\"/></svg><span>Tìm việc làm</span></a></nav><nav class=\"ds-workspace-footer\" aria-label=\"Điều hướng nhanh\"><a class=\"ds-workspace-link\" href=\"#account\" aria-label=\"Cài đặt tài khoản\"><span>Cài đặt tài khoản</span></a><a class=\"ds-workspace-link\" href=\"#switch\" aria-label=\"Chuyển phân hệ\"><span>Chuyển phân hệ</span></a><a class=\"ds-workspace-link\" href=\"#home\" aria-label=\"Trang chủ\"><span>Trang chủ</span></a></nav></aside>",
      "css": ".ds-workspace{display:flex;flex-direction:column;justify-content:space-between;box-sizing:border-box;width:244px;height:calc(100vh - 16px);margin:8px;padding:12px;border:1px solid var(--color-rule);border-radius:16px;background:var(--color-paper);color:var(--color-ink);font-family:var(--font-body)}.ds-workspace nav{display:grid;gap:6px}.ds-workspace-brand{padding:12px;color:var(--color-accent);font-weight:700}.ds-workspace-link{display:flex;align-items:center;gap:10px;min-height:44px;padding:0 12px;border-radius:8px;color:var(--color-ink-2);font-size:14px;text-decoration:none}.ds-workspace-link svg{width:20px;height:20px;flex:0 0 20px;fill:none;stroke:currentColor;stroke-width:1.7}.ds-workspace-link:hover{background:var(--color-paper-2)}.ds-workspace-link[aria-current=\"page\"]{background:var(--color-accent-subtle);color:var(--color-accent-deep);font-weight:600}.ds-workspace-link:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px}.ds-workspace-footer{border-top:1px solid var(--color-rule);padding-top:10px}.ds-workspace--collapsed{width:76px}.ds-workspace--collapsed .ds-workspace-link{justify-content:center;gap:0;padding-inline:0}.ds-workspace--collapsed .ds-workspace-link span,.ds-workspace--collapsed .ds-workspace-brand{max-width:0;overflow:hidden;opacity:0}"
    }
  ],
  "narrative": {
    "northStar": "Familiar recruitment, clear next steps",
    "overview": "Guardian Blue is a familiar, clear recruitment interface: white surfaces, cool blue-gray supporting grounds, dark blue text, and decisive blue actions. The user selected the category-standard direction with VietnamWorks as the craft reference. The implementation is code-first; the reference was not accessible for direct visual comparison.\n\nGuardianWork is a multi-industry recruitment platform. Public browsing uses generous search and listing areas, with business, marketing, finance, HR, operations and technology as peer categories. Candidate, recruiter, administrator, and authentication surfaces use the same tokens with task-appropriate density. Existing role boundaries and workflows remain the source of product behavior.",
    "keyCharacteristics": [
      "White and cool blue-gray surfaces with Guardian Blue actions.",
      "Hanken Grotesk for headings, body copy, labels, and workspace UI.",
      "Quiet borders, gently curved controls, and compact information hierarchy."
    ],
    "rules": [
      {
        "name": "The Guardian Blue Rule",
        "body": "Guardian Blue is the only product theme. Keep primary actions and focus consistent across public pages, authentication, and workspaces.",
        "section": "colors"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Use tonal grounds and thin rules for ordinary content; preserve the search form's soft elevation as a functional exception.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use Guardian Blue for primary actions, active navigation, and keyboard focus.",
      "Do keep muted text on light surfaces and preserve visible field labels and focus outlines.",
      "Do adapt grids and search controls to a single column on small phones.",
      "Do preserve role-specific routes, existing content, and the distinction between simulated and integrated capabilities.",
      "Do keep the Candidate/recruiter sidebar and header mounted while nested navigation changes only the main view.",
      "Do keep the exact three role-aware quick links at the bottom of both Candidate and recruiter sidebars.",
      "Do keep the compact collapsible rail scoped to Candidate and recruiter; preserve the Staff sidebar."
    ],
    "donts": [
      "Don't expose a theme selector or restore a saved palette preference.",
      "Don't introduce a different visual identity for a workspace or authentication page.",
      "Don't strengthen unverified product claims or document simulated actions as production integrations.",
      "Don't inherit legacy icon-font or decorative eyebrow treatments as new component patterns.",
      "Don't restore large icon wells or oversized sidebar icons to the Candidate/recruiter rail."
    ]
  }
}
