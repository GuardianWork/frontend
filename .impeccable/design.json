  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary action. It resolves to blue in public discovery and workspace main content, and charcoal in the surrounding monochrome chrome.",
      "html": "<div class=\"ds-content-scope\"><button class=\"ds-button\">Tìm việc ngay</button></div>",
      "css": ".ds-content-scope{--color-accent:var(--color-discovery-accent);--color-accent-hover:var(--color-discovery-hover);--color-accent-deep:var(--color-discovery-deep);--color-accent-subtle:var(--color-discovery-subtle);--color-focus:var(--color-discovery-accent)}.ds-button{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:13px 24px;min-height:48px;border:1px solid transparent;border-radius:8px;background:var(--color-accent);color:var(--color-accent-ink);font-family:var(--font-body);font-size:15px;font-weight:700;cursor:pointer;transition:background-color 160ms ease}.ds-button:hover{background:var(--color-accent-hover)}.ds-button:focus-visible{outline:3px solid var(--color-focus);outline-offset:3px}.ds-button:disabled{opacity:.55;cursor:not-allowed}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Supporting action; its color and focus treatment follow the same public/workspace content scope as the primary action.",
      "html": "<div class=\"ds-content-scope\"><button class=\"ds-outline\">Xem công việc</button></div>",
      "css": ".ds-content-scope{--color-accent:var(--color-discovery-accent);--color-accent-hover:var(--color-discovery-hover);--color-accent-deep:var(--color-discovery-deep);--color-accent-subtle:var(--color-discovery-subtle);--color-focus:var(--color-discovery-accent)}.ds-outline{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:13px 24px;min-height:48px;border:1px solid transparent;border-radius:8px;background:var(--color-accent);color:var(--color-accent-ink);font-family:var(--font-body);font-size:15px;font-weight:700;cursor:pointer;transition:background-color 160ms ease}.ds-outline:hover{background:var(--color-accent-hover)}.ds-outline:focus-visible{outline:3px solid var(--color-focus);outline-offset:3px}.ds-outline:disabled{opacity:.55;cursor:not-allowed}.ds-outline{background:var(--color-paper);color:var(--color-accent);border-color:var(--color-accent)}.ds-outline:hover{background:var(--color-accent-subtle)}"
    },
    {
      "name": "Search Input",
      "kind": "input",
      "refersTo": "search-input",
      "description": "Keyword input inside public discovery; its caret and focus use the scoped blue accent.",
      "html": "<div class=\"ds-content-scope\"><label class=\"ds-field\"><span>Từ khóa</span><input placeholder=\"Chức danh, kỹ năng hoặc công ty\" /></label></div>",
      "css": ".ds-content-scope{--color-accent:var(--color-discovery-accent);--color-accent-hover:var(--color-discovery-hover);--color-accent-deep:var(--color-discovery-deep);--color-accent-subtle:var(--color-discovery-subtle);--color-focus:var(--color-discovery-accent)}.ds-field{display:flex;flex-direction:column;gap:8px;padding:10px 16px;background:var(--color-paper);color:var(--color-ink);font-family:var(--font-body);font-size:15px}.ds-field input{min-height:44px;border:0;background:transparent;color:var(--color-ink);font:inherit;caret-color:var(--color-accent)}.ds-field input::placeholder{color:var(--color-ink-3)}.ds-field input:focus-visible{outline:3px solid var(--color-focus);outline-offset:3px}"
    },
    {
      "name": "Popular Skill Chip",
      "kind": "chip",
      "refersTo": "popular-chip",
      "description": "A linked popular keyword beneath search; hover and focus use the public content accent.",
      "html": "<div class=\"ds-content-scope\"><a class=\"ds-chip\" href=\"#jobs\">Kinh doanh</a></div>",
      "css": ".ds-content-scope{--color-accent:var(--color-discovery-accent);--color-accent-hover:var(--color-discovery-hover);--color-accent-deep:var(--color-discovery-deep);--color-accent-subtle:var(--color-discovery-subtle);--color-focus:var(--color-discovery-accent)}.ds-chip{display:inline-block;padding:4px 12px;border-radius:5px;background:var(--color-paper);color:var(--color-ink-2);font-family:var(--font-body);font-size:13px;text-decoration:none}.ds-chip:hover{color:var(--color-accent);text-decoration:underline}.ds-chip:focus-visible{outline:3px solid var(--color-focus);outline-offset:3px}"
    },
    {
      "name": "Job Card",
      "kind": "card",
      "refersTo": "job-card",
      "description": "Public listing card; job title, salary, hover, focus, and selected states use the content accent.",
      "html": "<div class=\"ds-content-scope\"><a class=\"ds-card\" href=\"#job\"><span class=\"ds-company\">GuardianWork</span><h3>Chuyên viên kinh doanh</h3><span class=\"ds-salary\">Thỏa thuận</span><span class=\"ds-location\">TP. Hồ Chí Minh</span></a></div>",
      "css": ".ds-content-scope{--color-accent:var(--color-discovery-accent);--color-accent-hover:var(--color-discovery-hover);--color-accent-deep:var(--color-discovery-deep);--color-accent-subtle:var(--color-discovery-subtle);--color-focus:var(--color-discovery-accent)}.ds-card{display:flex;flex-direction:column;gap:10px;padding:22px;border:1px solid var(--color-rule);border-radius:12px;background:var(--color-paper);color:var(--color-ink);font-family:var(--font-body);text-decoration:none;transition:border-color 160ms ease,background-color 160ms ease}.ds-card:hover{border-color:var(--color-accent);background:var(--color-paper-2)}.ds-card:focus-visible{outline:3px solid var(--color-focus);outline-offset:3px}.ds-company,.ds-location{color:var(--color-ink-2);font-size:13px}.ds-card h3{font-size:18px;font-weight:700;line-height:1.45;margin:8px 0 0}.ds-salary{font-size:14px;font-weight:650;color:var(--color-accent)}"
    },
    {
      "name": "Public Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Current and supporting public destinations.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Điều hướng\"><a href=\"#jobs\" aria-current=\"page\">Tìm việc làm</a><a href=\"#employers\">Nhà tuyển dụng</a></nav>",
      "css": ".ds-nav{display:flex;flex-wrap:wrap;gap:2px;background:var(--color-paper);font-family:var(--font-body)}.ds-nav a{display:inline-flex;align-items:center;min-height:40px;padding:0 13px;border-radius:8px;color:var(--color-ink-2);font-size:14px;font-weight:600;text-decoration:none;transition:background-color 160ms ease-out,color 160ms ease-out}.ds-nav a:hover{background:var(--color-paper-2);color:var(--color-ink)}.ds-nav a[aria-current=\"page\"]{background:var(--color-accent-subtle);color:var(--color-accent-deep)}.ds-nav a:focus-visible{outline:3px solid var(--color-focus);outline-offset:3px}"
    },
    {
      "name": "Candidate and Recruiter Workspace Frame",
      "kind": "nav",
      "refersTo": "workspace-rail",
      "description": "Persistent 244px/76px charcoal frame; its main region uses blue content accents, with one saved header collapse control and the three role-aware footer links.",
      "html": "<section class=\"ds-user-frame\"><aside class=\"ds-workspace\" aria-label=\"Điều hướng ứng viên\"><div class=\"ds-workspace-brand\">GuardianWork</div><nav aria-label=\"Điều hướng chính\"><a class=\"ds-workspace-link\" href=\"#jobs\" aria-label=\"Tìm việc làm\" aria-current=\"page\"><svg viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"M3 4h14v12H3zM7 4v12\"/></svg><span>Tìm việc làm</span></a></nav><nav class=\"ds-workspace-footer\" aria-label=\"Điều hướng nhanh\"><a class=\"ds-workspace-link\" href=\"#account\" aria-label=\"Cài đặt tài khoản\"><span>Cài đặt tài khoản</span></a><a class=\"ds-workspace-link\" href=\"#switch\" aria-label=\"Chuyển phân hệ\"><span>Chuyển phân hệ</span></a><a class=\"ds-workspace-link\" href=\"#home\" aria-label=\"Trang chủ\"><span>Trang chủ</span></a></nav></aside><div class=\"ds-user-content\"><header class=\"ds-user-header\"><button class=\"ds-collapse\" aria-label=\"Thu gọn điều hướng\" aria-expanded=\"true\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 6h16M4 12h16M4 18h16\"/></svg></button><button class=\"ds-mobile-menu\" aria-label=\"Mở menu điều hướng\" aria-expanded=\"false\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 6h16M4 12h16M4 18h16\"/></svg></button><strong>GuardianWork</strong></header><main><h2>Không gian làm việc</h2><p>Chọn bước tiếp theo để tiếp tục.</p><button class=\"ds-workspace-action\" type=\"button\">Tạo mục mới</button></main></div></section>",
      "css": ".ds-user-frame{display:grid;grid-template-columns:244px minmax(0,1fr);gap:8px;min-height:500px;background:var(--color-paper-2);color:var(--color-ink);font-family:\"Hanken Grotesk\",system-ui,sans-serif}.ds-workspace{display:flex;flex-direction:column;justify-content:space-between;box-sizing:border-box;min-height:484px;margin:8px;padding:12px;border:1px solid var(--color-rail-rule);border-radius:14px;background:var(--color-ink);color:var(--color-paper)}.ds-workspace nav{display:grid;gap:4px}.ds-workspace-brand{padding:12px;color:var(--color-paper);font-weight:700}.ds-workspace-link{display:flex;align-items:center;gap:12px;min-height:44px;padding:10px 12px;border-radius:8px;color:var(--color-paper);font-size:14px;text-decoration:none}.ds-workspace-link svg{width:20px;height:20px;flex:0 0 20px;fill:none;stroke:currentColor;stroke-width:1.7}.ds-workspace-link:hover{background:var(--color-rail-hover)}.ds-workspace-link[aria-current=\"page\"]{background:var(--color-paper);color:var(--color-ink);font-weight:650}.ds-workspace-link:focus-visible,.ds-collapse:focus-visible,.ds-mobile-menu:focus-visible{outline:2px solid var(--color-paper);outline-offset:2px}.ds-workspace-footer{align-content:end;border-top:1px solid var(--color-rail-rule);padding-top:10px}.ds-user-content{min-width:0}.ds-user-header{display:flex;align-items:center;gap:12px;min-height:76px;padding:0 24px;border-bottom:1px solid var(--color-rule);background:var(--color-paper)}.ds-user-header strong{font-size:20px}.ds-user-header button{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border:1px solid var(--color-rule);border-radius:6px;background:var(--color-paper);color:var(--color-ink-2)}.ds-user-header button svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:2}.ds-mobile-menu{display:none!important}.ds-user-content main{--color-accent:var(--color-discovery-accent);--color-accent-hover:var(--color-discovery-hover);--color-accent-deep:var(--color-discovery-deep);--color-accent-subtle:var(--color-discovery-subtle);--color-focus:var(--color-discovery-accent);min-height:400px;padding:28px;background:var(--color-paper)}.ds-user-content main h2{color:var(--color-discovery-deep)}.ds-workspace-action{min-height:44px;padding:10px 16px;border:0;border-radius:8px;background:var(--color-accent);color:var(--color-paper);font:700 14px \"Hanken Grotesk\",system-ui,sans-serif}.ds-workspace-action:hover{background:var(--color-accent-hover)}.ds-workspace-action:focus-visible{outline:3px solid var(--color-focus);outline-offset:3px}.ds-user-frame[data-collapsed=\"true\"]{grid-template-columns:76px minmax(0,1fr)}.ds-user-frame[data-collapsed=\"true\"] .ds-workspace{width:60px}.ds-user-frame[data-collapsed=\"true\"] .ds-workspace-brand,.ds-user-frame[data-collapsed=\"true\"] .ds-workspace-link span{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.ds-user-frame[data-collapsed=\"true\"] .ds-workspace-link{justify-content:center;gap:0;padding-inline:0}@media(max-width:1100px){.ds-user-frame{display:block;position:relative}.ds-workspace{position:absolute;z-index:2;inset:8px auto 8px 8px;width:min(300px,calc(100vw - 32px));margin:0}.ds-collapse{display:none!important}.ds-mobile-menu{display:inline-flex!important}.ds-user-header{min-height:68px;padding:0 12px}}"
    },
    {
      "name": "Staff Workspace Rail",
      "kind": "nav",
      "refersTo": "staff-rail",
      "description": "Staff retains its charcoal 280px/80px rail and its existing local toggle while using the shared site palette.",
      "html": "<aside class=\"ds-staff-rail\" aria-label=\"Điều hướng nhân viên\"><nav><a href=\"#review\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 5h16v14H4zM8 9h8M8 13h8\"/></svg><span>Hàng đợi xét duyệt</span></a><a href=\"#companies\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 20V6l8-3 8 3v14M8 10h2m4 0h2m-8 4h2m4 0h2\"/></svg><span>Doanh nghiệp</span></a></nav></aside>",
      "css": ".ds-staff-rail{box-sizing:border-box;display:flex;flex-direction:column;width:280px;min-height:500px;padding:18px 12px;background:var(--color-ink);color:var(--color-paper);font-family:\"Hanken Grotesk\",system-ui,sans-serif}.ds-staff-rail nav{display:grid;gap:8px}.ds-staff-rail a{display:flex;align-items:center;gap:10px;min-height:56px;padding:8px 10px;border:1px solid transparent;border-radius:12px;color:var(--color-paper);font-size:14px;text-decoration:none}.ds-staff-rail svg{display:block;width:40px;height:40px;flex:none;padding:9px;border-radius:12px;fill:none;stroke:currentColor;stroke-width:1.7}.ds-staff-rail a:hover{background:var(--color-rail-hover);border-color:var(--color-rail-rule)}.ds-staff-rail a[aria-current=\"page\"]{background:var(--color-paper);color:var(--color-ink);font-weight:650}.ds-staff-rail a:focus-visible{outline:2px solid var(--color-paper);outline-offset:2px}.ds-staff-rail[data-collapsed=\"true\"]{width:80px}.ds-staff-rail[data-collapsed=\"true\"] a{justify-content:center}.ds-staff-rail[data-collapsed=\"true\"] span{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}"
    },
    {
      "name": "Account and Recovery Controls",
      "kind": "input",
      "refersTo": "account-field",
      "description": "Shared 48px account and recovery field; account controls in workspace main content use the scoped blue treatment, while standalone recovery remains monochrome. The example shows the account-in-workspace context; standalone recovery inherits the monochrome root tokens.",
      "html": "<section class=\"ds-account-content\"><form class=\"ds-account-form\"><label>Email<input type=\"email\" placeholder=\"ten@congty.vn\" /></label><div><button class=\"ds-account-primary\" type=\"button\">Lưu thay đổi</button><button class=\"ds-account-quiet\" type=\"button\">Hủy</button></div></form></section>",
      "css": ".ds-account-content{--color-accent:var(--color-discovery-accent);--color-accent-hover:var(--color-discovery-hover);--color-accent-deep:var(--color-discovery-deep);--color-accent-subtle:var(--color-discovery-subtle);--color-focus:var(--color-discovery-accent)}.ds-account-form{display:grid;gap:16px;max-width:420px;color:var(--color-ink);font-family:\"Hanken Grotesk\",system-ui,sans-serif}.ds-account-form label{display:grid;gap:8px;font-size:14px;font-weight:600}.ds-account-form input{box-sizing:border-box;width:100%;min-height:48px;padding:10px 12px;border:1px solid var(--color-rule-2);border-radius:8px;background:var(--color-paper);color:var(--color-ink);font:400 16px/1.5 \"Hanken Grotesk\",system-ui,sans-serif}.ds-account-form input:focus-visible{outline:2px solid var(--color-focus);outline-offset:2px}.ds-account-form>div{display:flex;flex-wrap:wrap;gap:12px}.ds-account-form button{min-height:48px;padding:10px 18px;border:1px solid var(--color-accent);border-radius:8px;font:700 15px \"Hanken Grotesk\",system-ui,sans-serif;cursor:pointer}.ds-account-primary{background:var(--color-accent);color:var(--color-paper);transition:background-color 160ms ease}.ds-account-primary:hover{background:var(--color-accent-hover)}.ds-account-quiet{background:var(--color-paper);color:var(--color-ink);border-color:var(--color-rule-2)!important}.ds-account-quiet:hover{background:var(--color-paper-2)}.ds-account-form button:focus-visible{outline:2px solid var(--color-focus);outline-offset:2px}"
    },
    {
      "name": "Attention Notice",
      "kind": "custom",
      "refersTo": "attention-notice",
      "description": "Pale-pink semantic alert with a red circle-exclamation icon and readable charcoal copy.",
      "html": "<div class=\"ds-attention\" role=\"alert\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"11\"/><path d=\"M12 6v7M12 17v1\"/></svg><div><strong>Không thể lưu thay đổi</strong><p>Kiểm tra thông tin và thử lại.</p></div></div>",
      "css": ".ds-attention{position:relative;display:flex;align-items:flex-start;min-height:64px;margin:16px 0;padding:20px 24px 20px 58px;border:0;border-radius:16px;background:var(--color-attention-ground);color:var(--color-ink);font-family:\"Hanken Grotesk\",system-ui,sans-serif;font-size:15px;line-height:1.6;overflow-wrap:anywhere}.ds-attention svg{position:absolute;top:22px;left:24px;width:20px;height:20px;fill:var(--color-attention);stroke:var(--color-paper);stroke-width:2;stroke-linecap:round}.ds-attention strong{display:block;margin-bottom:4px;color:var(--color-ink);font-weight:700}.ds-attention p{margin:0;color:var(--color-ink)}@media(max-width:640px){.ds-attention{padding:18px 18px 18px 48px;font-size:14px}.ds-attention svg{top:20px;left:18px}}"
    },
    {
      "name": "Semantic status tags",
      "kind": "badge",
      "refersTo": "status-tag",
      "description": "Shared text-labeled status palette: green approved/active, red rejected/blocked, blue information, amber pending, slate inactive/draft. Keep a current-color border and bold legible text. Staff banners retain pink backgrounds and red exclamation icons. Staff list categories additionally use purple (#65319a on #f2eafa), orange (#9a3e0b on #fff0e6) and teal (#076568 on #e2f5f3), so distinct actions/states in each collection do not share one hue. Audit actions: green verify, red reject, orange hide, blue restore, purple lock, teal unlock. Withdrawn reviews use purple; recorded reports use teal.",
      "html": "<div class=\"ds-status-tags\"><span class=\"ds-status-success\">Đã xác minh</span><span class=\"ds-status-danger\">Đã khóa</span><span class=\"ds-status-info\">Mới tiếp nhận</span><span class=\"ds-status-warning\">Chờ duyệt</span><span class=\"ds-status-neutral\">Bản nháp</span></div>",
      "css": ".ds-status-tags{display:flex;flex-wrap:wrap;gap:8px}.ds-status-tags span{padding:4px 10px;border:1px solid currentColor;border-radius:5px;font:700 13px/20px \"Hanken Grotesk\",sans-serif}.ds-status-success{color:#176039;background:#e7f5eb}.ds-status-danger{color:#a12320;background:#fde9e7}.ds-status-info{color:#174b94;background:#e8f0ff}.ds-status-warning{color:#794400;background:#fff1d2}.ds-status-neutral{color:#454b55;background:#edf0f3}"
    }
  ],
  "narrative": {
    "northStar": "Familiar recruitment, clear next steps",
    "overview": "GuardianWork uses a monochrome frame across public chrome, authentication and recovery, and Candidate, Recruiter, and Staff workspace shells. Blue highlights content within public discovery and each workspace main area, while headers, footers, and sidebars stay charcoal and white. The approved `/rec` reference also informs pale-pink attention notices with a red exclamation mark and readable dark copy. Hanken Grotesk and existing task flows remain in place.\n\nGuardianWork remains a multi-industry recruitment platform. Public browsing keeps its familiar search and listing structure, while the three workspaces retain their role-specific navigation and density. The scoped palette adds emphasis to actionable content without changing role boundaries, content, or workflows.",
    "keyCharacteristics": [
      "Black, white, charcoal, and gray frame every site; blue highlights public discovery and workspace main content.",
      "Pale-pink notices and red exclamation marks communicate attention with dark readable copy.",
      "Hanken Grotesk for headings, body copy, labels, and workspace UI.",
      "Quiet borders, gently rounded controls, and compact information hierarchy."
    ],
    "rules": [
      {
        "name": "The Monochrome Chrome Rule",
        "body": "Use black, white, charcoal, and gray for public chrome, authentication and recovery, and workspace headers and sidebars. Keep the surrounding frame monochrome and do not create role-specific themes.",
        "section": "colors"
      },
      {
        "name": "The Blue Main Content Rule",
        "body": "Use the scoped blue accent in public discovery and in Candidate, Recruiter, and Staff workspace main content for actions, links, focus, selected content, section headings, account overview, and key figures. Keep headers, footers, and sidebars monochrome.",
        "section": "colors"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Use tonal grounds and thin rules for ordinary content; preserve the search form's soft elevation as a functional exception.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep public and workspace chrome, authentication, and standalone recovery in the shared monochrome palette.",
      "Do use blue accents in public discovery and the main content areas of Candidate, Recruiter, and Staff workspaces.",
      "Do reserve the pale-pink/red treatment for attention notices and keep their title and body dark.",
      "Do keep muted text on light surfaces and preserve visible field labels and focus outlines.",
      "Do adapt grids and search controls to a single column on small phones.",
      "Do preserve role-specific routes, existing content, and the distinction between simulated and integrated capabilities.",
      "Do keep the Candidate and Recruiter sidebars mounted and restore their shared saved collapse preference; nested routes change only the main view.",
      "Do keep the exact Candidate and Recruiter footer links, in order: Cài đặt tài khoản, Chuyển phân hệ, Trang chủ.",
      "Do retain the existing single header collapse control for Candidate/Recruiter and Staff's 280px/80px frame with its local toggle.",
      "Do preserve the shared 48px account and recovery form controls."
    ],
    "donts": [
      "Don't expose a theme selector or restore a saved palette preference.",
      "Don't introduce role-specific palettes or use attention colors for routine status decoration.",
      "Don't extend blue content accents to public headers/footers, authentication, standalone recovery, or workspace headers/sidebars.",
      "Don't strengthen unverified product claims or document simulated actions as production integrations.",
      "Don't inherit legacy icon-font or decorative eyebrow treatments as new component patterns.",
      "Don't add a second collapse toggle to the Candidate or Recruiter frame."
    ]
  }
}
